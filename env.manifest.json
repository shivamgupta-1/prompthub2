{
  "description": "Mapping of environments to their host URL and recommended env filename. Use this as a reference for CI/CD and deployment scripts.",
  "environments": {
    "development": {
      "host": "http://localhost:5173",
      "api": "http://localhost:4000/api",
      "envFile": ".env.development"
    },
    "qa": {
      "host": "https://qa.example.com",
      "api": "https://qa.example.com/api",
      "envFile": ".env.qa"
    },
    "production": {
      "host": "https://www.example.com",
      "api": "https://www.example.com/api",
      "envFile": ".env.production"
    }
  }
}
